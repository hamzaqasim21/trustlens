# ---------------------------------------------------------------------------
# TrustLens Gateway — copy this file to `.env` and edit.
# Every value has a working default, so an empty .env still runs.
# ---------------------------------------------------------------------------

# ---- Gemini, for the "Why?" explanations ----
# Free key from https://aistudio.google.com/apikey
# Leave blank and explanations fall back to rule-based text — everything else
# still works. NEVER put this key in the extension folder; it belongs here only.
GEMINI_API_KEY=
# Verified working. Don't use the moving aliases like `gemini-flash-latest` —
# one was measured ignoring the no-thinking setting and returning truncated text.
GEMINI_MODEL=gemini-2.5-flash

# ---- where the three modules are listening ----
# Transcriber  : D:\video-to-text transcriber      python run.py
# Classifier   : D:\trustlens_post_checker         uvicorn main:app --port 8001
# Account model: this folder                       uvicorn follower_api:app --port 8002
TRANSCRIBER_URL=http://127.0.0.1:8000
CLASSIFIER_URL=http://127.0.0.1:8001
FOLLOWER_URL=http://127.0.0.1:8002

# Where the fake-follower project lives (its artifacts are read in place).
FOLLOWER_MODULE_DIR=D:\trustlens-fake-follower-detection

# ---- this gateway ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100

# ---- timeouts (seconds) ----
FAST_TIMEOUT=60
# Whisper on a CPU runs at roughly realtime, so a 60s reel needs ~60s+.
TRANSCRIBE_TIMEOUT=900
POLL_INTERVAL=1.5
