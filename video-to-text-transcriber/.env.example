# ---------------------------------------------------------------------------
# TrustLens - Video-to-Text Transcriber
# Copy this file to `.env` and edit. Every value has a working default,
# so an empty .env still runs.
# ---------------------------------------------------------------------------

# ---- server ----
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*

# ---- ASR model ----
# tiny | base | small | medium | large-v3
#   small    ~1x realtime on a 2-core CPU  <- sensible default for a laptop
#   medium   better Urdu, ~3-4x slower
#   large-v3 best Urdu, needs a GPU to be practical
# You can also put any CTranslate2 HuggingFace repo id here (e.g. a fine-tuned
# Urdu Whisper), and it will be downloaded and used with no code change.
ASR_MODEL=small

# auto | cpu | cuda
ASR_DEVICE=auto
# auto | int8 | int8_float16 | float16 | float32   (auto = int8 on CPU)
ASR_COMPUTE_TYPE=auto
# 0 = use every core
ASR_CPU_THREADS=0
ASR_BEAM_SIZE=5

# ---- remote GPU offload ----
# Run this same service on a free Colab/Kaggle GPU with a public tunnel, then
# point a laptop at it. Lets you demo large-v3 in near real time.
ASR_BACKEND=local
# REMOTE_ASR_URL=https://your-tunnel.trycloudflare.com
# REMOTE_ASR_TOKEN=

# ---- language policy ----
# Whisper often labels Pakistani Urdu as Hindi. With this on, `hi` flips to `ur`
# when Urdu also scores at least URDU_BIAS_MIN_PROB. Turn off to see raw output.
URDU_BIAS_ENABLED=true
URDU_BIAS_MIN_PROB=0.15
LANG_DETECT_WINDOWS=3

# ---- anti-hallucination ----
VAD_ENABLED=true
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=500
CONDITION_ON_PREVIOUS_TEXT=false
NO_SPEECH_THRESHOLD=0.6

# ---- audio conditioning ----
# none | light | aggressive   (aggressive helps very loud background music)
AUDIO_DENOISE=light

# ---- OCR fallback (reads burned-in on-screen text) ----
# Needs: pip install -r requirements-optional.txt   (pulls PyTorch, ~2 GB)
OCR_ENABLED=false
OCR_LANGUAGES=ur,en
OCR_FRAME_COUNT=12
OCR_AUTO_FALLBACK=true

# ---- limits ----
MAX_DURATION_SEC=900
MAX_UPLOAD_MB=200
# Whisper saturates all cores; >1 makes concurrent jobs slower, not faster.
JOB_WORKERS=1
KEEP_MEDIA_FILES=false

# ---- database ----
# Blank = SQLite at data/transcriber.db (zero setup).
# Production per the scope document:
# DATABASE_URL=postgresql+psycopg://trustlens:password@localhost:5432/trustlens
DATABASE_URL=

# ---- Instagram / yt-dlp ----
# Instagram blocks anonymous reel downloads. Reading cookies from a logged-in
# browser is the fix for URL-based fetching.
# Values: chrome | edge | firefox | brave | opera
YTDLP_COOKIES_FROM_BROWSER=
# YTDLP_COOKIEFILE=C:/path/to/cookies.txt
