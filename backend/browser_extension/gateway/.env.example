# ---------------------------------------------------------------------------
# TrustLens Gateway — copy this file to `.env` and edit.
# Every value has a working default, so an empty .env still runs.
# ---------------------------------------------------------------------------

# ---- Gemini, for the "Why?" explanations ----
# Free key from https://aistudio.google.com/apikey
# Leave blank and explanations fall back to rule-based text — everything else
# still works. NEVER put this key in the extension folder; it belongs here only.
GEMINI_API_KEY=
# Verified working. Don't use the moving aliases like `gemini-flash-latest` —
# one was measured ignoring the no-thinking setting and returning truncated text.
GEMINI_MODEL=gemini-2.5-flash

# ---- where the models are ----
# Nothing to set. The gateway uses the misinformation and fake-account models
# loaded inside the TrustLens website backend (port 8000), so one copy of each
# model serves both the website and the extension. If you run the old
# standalone services instead (ports 8001 / 8002) it finds those by itself.
# Only set these to point somewhere unusual:
# CLASSIFIER_URL=http://127.0.0.1:8000/ext/classifier
# FOLLOWER_URL=http://127.0.0.1:8000/ext/account


# Where the TrustLens backend lives, so the two wrappers can import its models
# in place. Defaults to this repo's backend/ folder — only set this if you have
# moved things around.
# TRUSTLENS_BACKEND_DIR=D:\trustlens\backend

# ---- this gateway ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100

# ---- timeouts (seconds) ----
FAST_TIMEOUT=60
POLL_INTERVAL=1.5

# ---- reel audio (runs inside the gateway, no separate service) ----
# Whisper model size: base = fast (82s reel in ~4.5s, ~1.6 GB), small = better Urdu but ~2x slower and ~2.9 GB.
WHISPER_MODEL=base
